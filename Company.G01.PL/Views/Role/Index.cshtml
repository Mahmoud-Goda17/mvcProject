@model IEnumerable<RoleToReturnDtos>
@{
    ViewData["Title"] = "Index";
}

<h1>All Roles</h1>
<br />
<br />
<form>
    <div class="container m-4">
        <div class="row">
            <div class="col-6">
                <input placeholder="Search By Name" name="SearchInput" class="form-control" />

            </div>
            <div>
                <input type="submit" class="btn btn-success" value="Search" />
            </div>

        </div>

    </div>

</form>
<a  asp-action="Create" class="btn btn-primary">Create Roles</a>

<br />
<br />

@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <partial name="ButtonPartialView" model="@item.Id" />

                 </tr>
            }
        </tbody>
    </table>

}
else
{
    <div class="mt-4 alert alert-warning">
        <h4>There are No Roles :(</h4>
    </div>
}



