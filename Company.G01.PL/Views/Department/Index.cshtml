@model IEnumerable<Department>
@{
    ViewData["Title"] = "Index";
}

<h1>All DEPARTMENT</h1>
<br />
<br />
<form>
    <div class="container m-4">
        <div class="row">
            <div class="col-6">
                <input placeholder="Search By Name" name="SearchInput" class="form-control" />

            </div>
            <div>
                <input type="submit" class="btn btn-success" value="Search" />
            </div>

        </div>

    </div>

</form>

<a asp-controller="Department" asp-action="Create" class="btn btn-primary">Create Department</a>
<br />
<br />

@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Image</th>

                <th>Code</th>
                <th>Name</th>
                <th>Date Of Creation</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>
                        <img src="~/files/images/@department.ImageName" width="50" class="img-fluid rounded-circle" />
                    </td>

                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    <td>@department.CreateAt</td>
                    <partial name="ButtonPartialView" model="@department.Id.ToString()" />

                </tr>
            }
        </tbody>
    </table>

}
else
{
    <div class="mt-4 alert alert-warning">
        <h4>There is No Department :(</h4>
    </div>
}



