@model CreateEmployeeDtos
@{
    ViewData["Title"] = "Create";
}

<h1>Create Employee</h1>
<br />
<br />
<form asp-action="Create" asp-controller="Employee" enctype="multipart/form-data">

    <partial name="EmployeePartialView/CreateEditPartial" />
    <input type="submit" value="Create" class="btn btn-primary" />
    <a asp-controller="Employee" asp-action="Index" class="btn btn-light">Back To List</a>
    
</form>
@section ValidationSection{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}

